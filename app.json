{
  "expo": {
    "name": "KOUB",
    "slug": "koub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bh.koub.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "KOUB uses Face ID to unlock your workspace.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D8CEC3",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bh.koub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EC",
          "image": "./assets/splash.png",
          "imageWidth": 240
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#2B241D",
          "defaultChannel": "orders",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "scheme": "koub",
    "backgroundColor": "#F7F3EC",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "dfe9944f-b82e-47ef-b9da-36e73a10e43f"
      }
    },
    "owner": "koubbh.com",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dfe9944f-b82e-47ef-b9da-36e73a10e43f"
    }
  }
}
